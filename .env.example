# Backend / FastAPI (keep all values except NEXT_PUBLIC_API_BASE_URL server-side)
MARKETMIND_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./marketmind.db
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ENABLE_OPENAI_ANALYSIS=false
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_FEED=iex
# Replace the example with a descriptive name and email before enabling EDGAR.
SEC_USER_AGENT=MarketMind local-user contact@example.com
ENABLE_PAPER_TRADING=true
# Keep false in an internet deployment until proper user authentication exists.
ENABLE_REMOTE_PAPER_ORDERS=false
ENABLE_LIVE_TRADING=false

# Frontend / Next.js. This URL is public and must never contain credentials.
# Leave blank to use the same-origin /api proxy. Set it to https://your-api-host in a direct-CORS deployment.
NEXT_PUBLIC_API_BASE_URL=
# Server-side Next.js rewrite target for local Docker/Vercel proxy deployments.
BACKEND_URL=http://localhost:8000
