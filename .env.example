# Backend / FastAPI. Keep every value here server-side except the two explicitly
# named NEXT_PUBLIC Supabase values used by the browser client.
MARKETMIND_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./marketmind.db
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Fail-closed identity configuration. Required in production.
AUTH_MODE=required
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
AUTH_JWT_AUDIENCE=authenticated
AUTH_JWT_ALGORITHMS=ES256,RS256
AUTH_JWKS_CACHE_SECONDS=300
ADMIN_MFA_REQUIRED=true
AUDIT_IP_HMAC_SECRET=
RATE_LIMIT_PER_MINUTE=120
# Optional Redis is required before any remote execution can ever be enabled.
# The current release remains preview-only regardless of this value.
REDIS_URL=
RATE_LIMIT_REQUIRE_SHARED_FOR_EXECUTION=true
MAX_REQUEST_BODY_BYTES=1000000
EXECUTOR_INTENT_SIGNING_KEY=
# Disabled by default. Set only for the documented one-time first-admin setup,
# then set false and remove the secret immediately after a successful call.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_SECRET=
BOOTSTRAP_ADMIN_RATE_LIMIT_PER_HOUR=3
# Required with BOOTSTRAP_ADMIN_ENABLED=true in production, ISO-8601 UTC.
BOOTSTRAP_ADMIN_EXPIRES_AT=
AUTO_CREATE_SCHEMA=

# Optional data/AI providers. Empty values use clearly labelled demo data after
# an authenticated user is present.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ENABLE_OPENAI_ANALYSIS=false
# Market-data-only key. Do not use a credential capable of broker execution.
ALPACA_MARKET_DATA_API_KEY=
ALPACA_MARKET_DATA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_FEED=iex
# Optional options feed. `indicative` is broadly available; `opra` requires an
# Alpaca plan that permits it. MarketMind never creates option fields that the
# selected feed does not provide.
ALPACA_OPTIONS_FEED=indicative
MARKET_DATA_REQUEST_TIMEOUT_SECONDS=8
MARKET_DATA_STALE_SECONDS=900
SEC_USER_AGENT=MarketMind local-user contact@example.com

# Broker/OAuth safety. Keep both execution flags false in every public deployment.
ENABLE_PAPER_TRADING=true
ENABLE_REMOTE_PAPER_ORDERS=false
ENABLE_LIVE_TRADING=false
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=
ALPACA_OAUTH_REDIRECT_URI=

# Next.js server-only proxy target. It must not contain a path, credential, or token.
BACKEND_URL=http://localhost:8000
# These are public browser configuration values, not secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
